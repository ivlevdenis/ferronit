#!/usr/bin/env bash
# Предохранитель от коммитов без разрешения пользователя.
#
# Правило проекта (AGENTS.md, «Границы работ»): коммитить только по явной просьбе.
# Хук не даёт забыть: без осознанно выставленной FERRONIT_COMMIT_OK=1 коммит падает.
#
# Есть разрешение пользователя — повторить коммит так:
#     FERRONIT_COMMIT_OK=1 git commit -m "сообщение"
#
# Отключить локально (не рекомендуется): git config --unset core.hooksPath
set -uo pipefail

if [ "${FERRONIT_COMMIT_OK:-}" != "1" ]; then
    cat >&2 <<'EOF'
⛔ Коммит заблокирован: нет явного разрешения пользователя (AGENTS.md, «Границы работ»).

Сначала покажи `git status` / `git diff --stat` и спроси. Если разрешение уже есть:

    FERRONIT_COMMIT_OK=1 git commit -m "..."
EOF
    exit 1
fi
